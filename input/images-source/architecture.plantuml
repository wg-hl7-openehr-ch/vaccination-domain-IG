@startuml
skinparam shadowing true
skinparam rectangle {
  roundCorner 5
}
skinparam defaultFontSize 16

title Vaccination Domain Service Architecture

together {
  rectangle  "Producer APP" as PROD #LightCyan {
     
      rectangle "Frontend" as pfnt #LightYellow {  
      }
      rectangle "Backend" as pbck #LightYellow {
        rectangle "FHIR Client" as fcltp #OrangeRed
      }
  }
  rectangle "Consumer APP" as CONS #LightGreen {
    rectangle "Frontend" as cfnt #LightYellow {
        
    }
    rectangle "Backend" as cbck #LightYellow {
    rectangle "FHIR Client" as fcltc #OrangeRed {
    }
    }
  }

  rectangle "Vaccination Domain Service" as Server #LightBlue {
    together {
    rectangle "FHIR Facade" as fapi #OrangeRed

    rectangle "Business Logic" as blogic #LightYellow

    database "Administrative DB" as vdb #LightGray

    rectangle "openFHIR Server" as ofhir #Orange
    database "Mapping DB" as mdb #LightGray

    rectangle "openEHR Server" as ehr #Orange
    database "openEhr DB" as ehrdb #LightGray
    }
  }

}

pfnt --> pbck
cfnt --> cbck

fcltc <--> fapi
fcltp <--> fapi

fapi --> blogic
blogic --> vdb
ofhir --> mdb
blogic --> ehr
blogic --> ofhir
ehr --> ehrdb


@enduml